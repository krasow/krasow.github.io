{#- Homepage sections, used from the body of content/index.md. -#}
{%- import "partials/ui.njk" as ui %}
{%- import "partials/education.njk" as education %}

{%- macro greeting(text) %}
<div class="holder title-lg hello-world">{{ text }}</div>
{%- endmacro %}

{#- Mobile business card and the desktop split terminal (summary / education / contact). #}
{%- macro terminal(site, summary, schools) %}
<div id="terminal">
  <!-- Mobile: business card -->
  <div class="mobile-card">
    <div class="mobile-card-command">david:~$ whoami</div>
    <div class="mobile-card-header">
      <div>
        <div class="mobile-card-name">{{ site.name }}</div>
        <div class="mobile-card-title">{{ site.headline }}</div>
      </div>
      <div class="mobile-card-links">
        <a href="{{ site.resume }}" class="mobile-card-save">Resume</a>
      </div>
    </div>
    <hr class="mobile-card-divider" />
    <div class="mobile-card-contact-row">
      <div>
        <div class="mobile-card-row">{{ site.location }}</div>
        <div class="mobile-card-row">{{ site.phone }}</div>
        <div class="mobile-card-row"><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
      </div>
      <a href="{{ site.contactCard }}" download class="mobile-card-save">Contact</a>
    </div>
    <hr class="mobile-card-divider" />
    <div class="mobile-card-icons">
      <a href="{{ site.github }}" target="_blank"><i class="fa fa-github"></i></a>
      <a href="{{ site.linkedin }}" target="_blank"><i class="fa fa-linkedin"></i></a>
      <a href="{{ site.scholar }}" target="_blank"><i class="fa fa-graduation-cap"></i></a>
    </div>
    <hr class="mobile-card-divider" />
    {%- for school in schools %}
    <div class="mobile-card-row">{{ school.org }} ({{ school.date }})</div>
    <div class="mobile-card-sub">{{ school.title }}</div>
    {%- endfor %}
  </div>

  <!-- Desktop: split terminal -->
  <div class="terminal-split terminal-desktop-only">
    <div class="terminal-cmds">
      <div class="command active" data-idx="0">david:~$ summary</div>
      <div class="command" data-idx="1">david:~$ education</div>
      <div class="command" data-idx="2">david:~$ contact</div>
    </div>
    <div class="terminal-output">
      <div class="response response-sm active" data-idx="0">
        <div id="terminal-summary" class="md-response">{{ summary.templateContent | trim }}</div>
        <div class="summary-links">
          <a href="/pages/cv.html" class="mobile-card-save">View CV</a>
          <a href="{{ site.resume }}" download class="mobile-card-save">Download Resume</a>
        </div>
      </div>
      <div class="response response-md" data-idx="1">
        <div id="terminal-education" class="response-block md-response">
          {{- education.text(schools) | forceescape -}}
        </div>
      </div>
      <div class="response response-md" data-idx="2">
        <div class="contact-flex">
          <div class="contact-left">
            <div class="response-block">
              {{ site.name }}<br />
              {{ site.location }}<br />
              <a href="mailto:{{ site.email }}">{{ site.email }}</a><br />
              {{ site.phone }}
            </div>
            <div class="contact-icons">
              <a href="{{ site.github }}" target="_blank"><i class="fa fa-github"></i></a>
              <a href="{{ site.linkedin }}" target="_blank"><i class="fa fa-linkedin"></i></a>
              <a href="{{ site.scholar }}" target="_blank"><i class="fa fa-graduation-cap"></i></a>
            </div>
            <div class="contact-buttons">
              <a href="{{ site.contactCard }}" download class="mobile-card-save">Download Contact</a>
              <a href="{{ site.calendar }}" target="_blank" class="mobile-card-save">Schedule a Meeting</a>
            </div>
          </div>
          <img class="contact-photo" src="{{ site.photo }}" alt="{{ site.name }}" />
        </div>
      </div>
    </div>
  </div>
</div>
{%- endmacro %}

{#- Cards for projects that have a `card:` in front matter, by `card.order`. #}
{%- macro projects(items) %}
<div id="projects">
  <div class="holder">
    <div class="title-lg">Projects</div>
    <div class="projects-grid">
      {%- for project in items | sort(false, false, "data.card.order") %}
      {%- if project.data.card %}
      <div class="project-card">
        <a href="{{ project.url }}">
          <div class="title">{{ project.data.card.name }}</div>
          <img class="project-image" src="{{ project.data.card.image }}" alt="Project image" />
          <div class="venue">{{ project.data.card.org }}</div>
        </a>
      </div>
      {%- endif %}
      {%- endfor %}
    </div>
  </div>
</div>
{%- endmacro %}

{#- Roles with their full description (the body of each experience file). #}
{%- macro experience(jobs) %}
<div id="experience">
  <div class="holder">
    <div class="title-lg">Experience</div>
    {%- for job in jobs | newestFirst %}

    <div class="event pub-event">
      <div class="pub-left">
        <div class="pub-date">{{ job.date | monthYear | replace(" ", "&nbsp;") | safe }}<br />{{ job.data.end | replace(" ", "&nbsp;") | safe }}</div>
        {%- if job.data.logo %}
        <img src="{{ job.data.logo }}" class="exp-logo" alt="{{ job.data.org }}" />
        {%- endif %}
      </div>
      <div class="pub-content">
        <div class="title">{{ job.data.title }}</div>
        <div class="venue">{{ job.data.org | md | safe }}</div>
        <div class="description">{{ job.templateContent | unwrap | safe }}</div>
      </div>
    </div>
    {%- endfor %}
  </div>
</div>
{%- endmacro %}

{%- macro publications(pubs) %}
<div id="publications">
  <div class="holder">
    <div class="title-lg">Publications and Technical Reports</div>
    {%- for pub in pubs | newestFirst %}

    <div class="event pub-event">
      <div class="pub-left">
        <div class="pub-year">{{ pub.date | year }}</div>
      </div>
      <div class="pub-content">
        <div class="title-sm">
          {%- if pub.data.url %}<a href="{{ pub.data.url }}">{{ pub.data.title }}</a>
          {%- else %}{{ pub.data.title }}{% endif -%}
        </div>
        <div class="description">{{ pub.data.authors | authors | safe }}</div>
        <div class="venue">{{ pub.data.venue | md | safe }}</div>
        {{- ui.links(pub.data.links) }}
      </div>
    </div>
    {%- endfor %}
  </div>
</div>
{%- endmacro %}

{%- macro skills(list) %}
<div class="container language">
  {%- for skill in list %}
  <div class="language-item">{{ skill }}</div>
  {%- endfor %}
</div>
{%- endmacro %}
