<div class="holder">
  <div class="title-lg">Projects</div>
  <div class="projects-grid">
    {%- for project in collections.projects | sort(false, false, "data.card.order") %}
    {%- if project.data.card %}
    <div class="project-card">
      <a href="{{ project.url }}">
        <div class="title">{{ project.data.card.name }}</div>
        <img class="project-image" src="{{ project.data.card.image }}" alt="Project image" />
        <div class="venue">{{ project.data.card.org }}</div>
      </a>
    </div>
    {%- endif %}
    {%- endfor %}
  </div>
</div>
