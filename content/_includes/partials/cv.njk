{#- CV sections, used from the body of content/cv.md. -#}

{%- macro entry(date, title, org, desc) %}
<div class="cv-entry">
  <div class="cv-date">{{ date | safe }}</div>
  <div class="cv-body">
    <span class="cv-title">{{ title | safe }}</span>
    <span class="cv-org">{{ org | safe }}</span>
    {%- if desc %}
    <span class="cv-desc">{{ desc | safe }}</span>
    {%- endif %}
  </div>
</div>
{%- endmacro %}

{%- macro section(name) %}
<div class="cv-section">
  <div class="cv-section-title">{{ name }}</div>
  <hr />
  {{- caller() }}
</div>
{%- endmacro %}

{#- Entries written in cv.md's front matter (title, date, org, location, desc). #}
{%- macro list(name, items) %}
  {%- call section(name) %}
    {%- for item in items %}
      {%- set org = item.org + (", " + item.location if item.location else "") %}
      {{- entry(item.date, item.title | md, org | md, item.desc | md) }}
    {%- endfor %}
  {%- endcall %}
{%- endmacro %}

{#- Roles from content/experience/, using each one's short `summary`. #}
{%- macro experience(name, jobs) %}
  {%- call section(name) %}
    {%- for job in jobs | newestFirst %}
      {%- set dates = "<span>" + (job.date | monthYear) + "</span><span>" + job.data.end + "</span>" %}
      {{- entry(dates, job.data.title | md, job.data.org | md, job.data.summary | md) }}
    {%- endfor %}
  {%- endcall %}
{%- endmacro %}

{#- Papers from content/publications/, using the `short` venue when set. #}
{%- macro publications(name, pubs) %}
  {%- call section(name) %}
    {%- for pub in pubs | newestFirst %}
      {%- set title = pub.data.title | md %}
      {%- if pub.data.url %}{% set title = '<a href="' + pub.data.url + '">' + title + '</a>' %}{% endif %}
      {{- entry(pub.date | year, title, (pub.data.short or pub.data.venue) | md, pub.data.authors | authors) }}
    {%- endfor %}
  {%- endcall %}
{%- endmacro %}

{#- Talks from content/presentations/ whose `kind` matches, titles linked to the slides. #}
{%- macro talks(name, items, kind) %}
  {%- call section(name) %}
    {%- for talk in items | newestFirst | where("kind", kind) %}
      {%- set title = talk.data.title | md %}
      {%- if talk.data.links.Slides %}{% set title = '<a href="' + talk.data.links.Slides + '">' + title + '</a>' %}{% endif %}
      {%- set venue = talk.data.venue | md %}
      {%- if talk.data.venueUrl %}{% set venue = '<a href="' + talk.data.venueUrl + '">' + venue + '</a>' %}{% endif %}
      {{- entry(talk.date | monthYear, title, venue) }}
    {%- endfor %}
  {%- endcall %}
{%- endmacro %}

{#- Posters from content/posters/, titles linked to the PDFs. #}
{%- macro posters(name, items) %}
  {%- call section(name) %}
    {%- for poster in items | newestFirst %}
      {%- set title = '<a href="' + poster.data.file + '">' + (poster.data.title | md) + '</a>' %}
      {{- entry(poster.date | monthYear, title, poster.data.venue | md) }}
    {%- endfor %}
  {%- endcall %}
{%- endmacro %}
