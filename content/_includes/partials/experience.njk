<div class="holder">
  <div class="title-lg">Experience</div>
  {%- for job in collections.experience | newestFirst %}

  <div class="event pub-event">
    <div class="pub-left">
      <div class="pub-date">{{ job.date | monthYear | replace(" ", "&nbsp;") | safe }}<br />{{ job.data.end | replace(" ", "&nbsp;") | safe }}</div>
      {%- if job.data.logo %}
      <img src="{{ job.data.logo }}" class="exp-logo" alt="{{ job.data.org }}" />
      {%- endif %}
    </div>
    <div class="pub-content">
      <div class="title">{{ job.data.title }}</div>
      <div class="venue">{{ job.data.org | md | safe }}</div>
      <div class="description">{{ job.templateContent | unwrap | safe }}</div>
    </div>
  </div>
  {%- endfor %}
</div>
