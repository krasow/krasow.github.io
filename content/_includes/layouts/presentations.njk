---
layout: layouts/base.njk
---
{%- for section in sections %}
{%- if not loop.first %}

<div class="holder"><div class="section-divider"></div></div>
{%- endif %}

<div class="holder">
  <div class="title-lg">{{ section.title }}</div>
  {%- for talk in collections.presentations | newestFirst | where("kind", section.kind) %}

  <div class="event pub-event">
    <div class="pub-left">
      <div class="pub-year"><span class="pub-month">{{ talk.date | month }}</span><br />{{ talk.date | year }}</div>
    </div>
    <div class="pub-content">
      <div class="title-sm">{{ talk.data.title }}</div>
      <div class="venue">{{ talk.data.venue | md | safe }}</div>
      {%- set links = talk.data.links %}
      {%- include "partials/links.njk" %}
    </div>
  </div>
  {%- endfor %}
</div>
{%- endfor %}
