% Layout for the generated resume (content/documents/resume.11ty.js writes
% the body from the site's content files). Edit the look here, the content in
% content/.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{resume}

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
% TeX Gyre Heros rather than helvet: helvet's URW Nimbus Sans has dropped
% bold capitals on some printers.
\RequirePackage{tgheros}
\renewcommand{\familydefault}{\sfdefault}
\RequirePackage[letterpaper, margin=0.5in, top=0.4in, bottom=0.4in]{geometry}
\RequirePackage[usenames,dvipsnames]{xcolor}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{tabularx}
\RequirePackage{microtype}
\RequirePackage[hidelinks]{hyperref}

% Byte-for-byte reproducible PDFs, so rebuilding unchanged content leaves the
% committed file untouched.
\pdfinfoomitdate=1
\pdftrailerid{}
\pdfsuppressptexinfo=-1

\definecolor{accent}{HTML}{1F2A44}
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\tabcolsep}{0pt}
\raggedright

\titleformat{\section}{\large\bfseries\color{accent}}{}{0pt}{}[\vspace{-0.3ex}\color{accent}\titlerule]
\titlespacing*{\section}{0pt}{1ex}{0.5ex}

\setlist[itemize]{leftmargin=1.4em, topsep=0.2ex, itemsep=0pt, parsep=0pt, label=\textbullet}

% \resumeheader{name}{contact lines separated by \\}: name on the left,
% contact details stacked on the right.
\newcommand{\resumeheader}[2]{%
  \begin{minipage}[b]{0.55\linewidth}
    {\fontsize{24}{28}\selectfont\bfseries #1}
  \end{minipage}%
  \hfill
  \begin{minipage}[b]{0.45\linewidth}
    \raggedleft\small\renewcommand{\arraystretch}{1.1}%
    \begin{tabular}[b]{@{}r@{}}#2\end{tabular}
  \end{minipage}\par}

% \role{title}{organization}{dates}
\newcommand{\role}[3]{%
  \begin{tabularx}{\linewidth}{@{}X r@{}}
    \textbf{#1}, #2 & #3 \\
  \end{tabularx}\par}

% \paper{tag}{title}{authors}{detail}
\newcommand{\paper}[4]{%
  \textbf{[#1]} #2\par
  {\small #3. #4}\par\vspace{0.5ex}}

% \dated{left}{right}
\newcommand{\dated}[2]{%
  \begin{tabularx}{\linewidth}{@{}X r@{}}
    #1 & #2 \\
  \end{tabularx}\par}
